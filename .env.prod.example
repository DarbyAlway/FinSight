# .env.prod.example — copy to .env on the server and fill in real values.
# NEVER commit the filled-in .env.

# --- LLM provider (external) ---
SAMBANOVA_API_KEY=your-sambanova-key

# --- Web search fallback (external) ---
TAVILY_API_KEY=your-tavily-key

# --- App database (compose-internal host = the 'postgres' service) ---
POSTGRES_PASSWORD=choose-a-strong-password
DATABASE_URL=postgresql://finsight:choose-a-strong-password@postgres:5432/finsight

# --- Qdrant (compose-internal host = the 'qdrant' service) ---
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# --- DuckDB cache + ticker table (on the mounted /data volume) ---
CACHE_DB_PATH=/data/cache.db

# --- SEC/EDGAR contact string (required by SEC) ---
EDGAR_IDENTITY=Your Name your-email@example.com

# --- Auth / quota ---
OWNER_EMAIL=your-owner-email@example.com
GLOBAL_TOKEN_CAP=5000000
SESSION_TTL_DAYS=30
SESSION_COOKIE_SECURE=1

# --- Langfuse on YOUR PC, reached over Tailscale ---
# Use your PC's Tailscale IP (100.x.y.z) or MagicDNS name.
LANGFUSE_HOST=http://100.x.y.z:3000
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...

# --- Tailscale auth key for the sidecar (from the Tailscale admin console) ---
TS_AUTHKEY=tskey-auth-...
