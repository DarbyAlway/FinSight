config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	plan(plan)
	gates(gates)
	agent(agent)
	collect(collect)
	proactive_web(proactive_web)
	synthesize(synthesize)
	web_fallback(web_fallback)
	fidelity_check(fidelity_check)
	self_critique(self_critique)
	web_escalate(web_escalate)
	finalize(finalize)
