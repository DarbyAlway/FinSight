	__start__ --> plan;
	agent --> collect;
	collect -.-> proactive_web;
	collect -.-> synthesize;
	fidelity_check -.-> finalize;
	fidelity_check -.-> self_critique;
	gates -.-> agent;
	gates -.-> collect;
	plan --> gates;
	proactive_web --> synthesize;
	self_critique -.-> finalize;
	self_critique -.-> web_escalate;
	synthesize -.-> fidelity_check;
	synthesize -.-> finalize;
	synthesize -.-> web_fallback;
	web_escalate --> finalize;
	web_fallback -.-> fidelity_check;
	web_fallback -.-> finalize;
	finalize --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
